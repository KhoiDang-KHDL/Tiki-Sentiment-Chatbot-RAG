{
  "uid": "tiki-api",
  "title": "Tiki ABSA — API & Streaming",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "tiki",
    "absa",
    "monitoring"
  ],
  "timezone": "Asia/Ho_Chi_Minh",
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "description": "Choose tiki-api for real retrieval/provider traffic; tiki-loadtest for isolated synthetic LLM traffic. Health and scrape requests are excluded from custom HTTP latency/rate metrics. No token samples means no TTFT data.",
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Target",
        "type": "custom",
        "query": "tiki-api,tiki-loadtest",
        "current": {
          "text": "tiki-api",
          "value": "tiki-api"
        },
        "options": [
          {
            "text": "tiki-api",
            "value": "tiki-api",
            "selected": true
          },
          {
            "text": "tiki-loadtest",
            "value": "tiki-loadtest",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "API reachable (1 = UP)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "tiki-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Chưa có mẫu",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"$job\"}",
          "legendFormat": "",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP requests / second",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "tiki-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "Chưa có mẫu",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(tiki_http_requests_total{job=\"$job\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP 5xx error ratio",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "tiki-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Chưa có mẫu",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(tiki_http_requests_total{job=\"$job\",status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(tiki_http_requests_total{job=\"$job\"}[$__rate_interval])),0.000001) or vector(0)",
          "legendFormat": "",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Active requests",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "tiki-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Chưa có mẫu",
          "thresholds": {
            "mode": "absolute",
